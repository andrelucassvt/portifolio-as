{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servir portfólio",
      "type": "shell",
      "command": "lsof -ti tcp:4173 | xargs kill 2>/dev/null; python3 -m http.server 4173",
      "isBackground": true,
      "problemMatcher": {
        "owner": "portfolio",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving HTTP on .* port 4173.*"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
